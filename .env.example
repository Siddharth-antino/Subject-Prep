# Server only. Copy to .env in the repository root.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional ordered reasoning fallbacks; maximum two. Empty disables model switching.
# The configured chain tries 3.8 Flash, then 3.7 Flash, then 3.5 Flash-Lite.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# Dedicated server speech tools, using the same Gemini key.
GEMINI_LIVE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_SPEECH_MODEL=gemini-3.8-flash-lite-tts
PREP_PORT=8788
PREP_WEB_PORT=5174
PREP_PREVIEW_PORT=4174
# Optional. Empty URI keeps local JSON storage; a configured URI requires MongoDB.
MONGODB_URI=
MONGODB_DB=subject_prep
MONGODB_COLLECTION=preparation_sessions
# Optional relative or absolute JSON session directory.
PREP_STORAGE_DIR=.sessions
# Single local learner namespace, not authentication.
MONGODB_LEARNER_ID=local
